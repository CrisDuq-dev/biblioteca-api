# Renombrar este archivo a .env y completar con los datos reales.
# NUNCA subir el archivo .env real al repositorio (ya esta en .gitignore).

# --- Servidor ---
PORT=3000

# --- Base de datos MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=biblioteca_db

# --- Seguridad ---
# Clave secreta usada para firmar los tokens JWT. Debe ser larga y aleatoria.
JWT_SECRET=cambia_esta_clave_por_una_segura_y_aleatoria
JWT_EXPIRES_IN=2h

# Numero de rondas (salt rounds) para el hash de contrasenas con bcrypt
BCRYPT_SALT_ROUNDS=10
